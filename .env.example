# Naver: enable IMAP/SMTP and use an application password when 2-step verification is enabled.
NAVER_EMAIL=your-id@naver.com
NAVER_PASSWORD=your-naver-app-password

# Nate: IMAP uses imap.nate.com:993 SSL.
NATE_EMAIL=your-id@nate.com
NATE_PASSWORD=your-nate-password

# Kakao Developers app
KAKAO_REST_API_KEY=your-rest-api-key
KAKAO_CLIENT_SECRET=your-client-secret
KAKAO_REFRESH_TOKEN=your-refresh-token
KAKAO_REDIRECT_URI=http://localhost:3000/oauth/kakao

# Must be a web domain registered in Kakao Developers > Product Link.
KAKAO_LINK_URL=https://example.com

# Search window. 28 hours gives a little safety margin around a once-daily schedule.
LOOKBACK_HOURS=28

# Minimum importance score. Recommended: 4
IMPORTANCE_THRESHOLD=4

# true = send a Kakao message even when nothing important is found
SEND_EMPTY_SUMMARY=false
